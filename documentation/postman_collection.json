{
  "info": {
    "name": "URL Shortener API",
    "description": "Complete API collection for URL Shortener service with authentication, URL shortening, and dashboard endpoints",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user account"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/register",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "register"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyQGV4YW1wbGUuY29tIiwiaWF0IjoxNjk0NTIwMDAwLCJleHAiOjE2OTQ2MDY0MDB9.signature\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.token);",
                  "    pm.test('Registration successful', function () {",
                  "        pm.expect(response.token).to.be.a('string');",
                  "    });",
                  "} else {",
                  "    pm.test('Registration failed', function () {",
                  "        pm.expect(pm.response.code).to.not.equal(200);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with existing user credentials"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "login"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyQGV4YW1wbGUuY29tIiwiaWF0IjoxNjk0NTIwMDAwLCJleHAiOjE2OTQ2MDY0MDB9.signature\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.token);",
                  "    pm.test('Login successful', function () {",
                  "        pm.expect(response.token).to.be.a('string');",
                  "    });",
                  "} else {",
                  "    pm.test('Login failed', function () {",
                  "        pm.expect(pm.response.code).to.not.equal(200);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "URL Shortener",
      "item": [
        {
          "name": "Shorten URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://www.example.com/very-long-url-that-needs-shortening\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/url/shorten",
              "host": ["{{base_url}}"],
              "path": ["url", "shorten"]
            },
            "description": "Create a shortened URL"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwt_token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"originalUrl\": \"https://www.example.com/very-long-url-that-needs-shortening\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/url/shorten",
                  "host": ["{{base_url}}"],
                  "path": ["url", "shorten"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"code\": \"abc12345\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('short_code', response.code);",
                  "    pm.test('URL shortened successfully', function () {",
                  "        pm.expect(response.code).to.be.a('string');",
                  "        pm.expect(response.code).to.have.lengthOf(8);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Redirect to Original URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/url/{{short_code}}",
              "host": ["{{base_url}}"],
              "path": ["url", "{{short_code}}"]
            },
            "description": "Redirect to original URL and increment usage count"
          },
          "response": [
            {
              "name": "Redirect",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/url/abc12345",
                  "host": ["{{base_url}}"],
                  "path": ["url", "abc12345"]
                }
              },
              "status": "Found",
              "code": 302,
              "_postman_previewlanguage": "text",
              "header": [
                {
                  "key": "Location",
                  "value": "https://www.example.com/very-long-url-that-needs-shortening"
                }
              ],
              "cookie": [],
              "body": ""
            }
          ]
        },
        {
          "name": "Update URL Expiration",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expiration\": \"2024-12-31T23:59:59\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/url/{{short_code}}/expiration",
              "host": ["{{base_url}}"],
              "path": ["url", "{{short_code}}", "expiration"]
            },
            "description": "Update expiration date for a shortened URL"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwt_token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"expiration\": \"2024-12-31T23:59:59\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/url/abc12345/expiration",
                  "host": ["{{base_url}}"],
                  "path": ["url", "abc12345", "expiration"]
                }
              },
              "status": "No Content",
              "code": 204,
              "_postman_previewlanguage": "text",
              "header": [],
              "cookie": [],
              "body": ""
            }
          ]
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/summary",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "summary"]
            },
            "description": "Get overall statistics summary for the authenticated user"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwt_token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/dashboard/summary",
                  "host": ["{{base_url}}"],
                  "path": ["dashboard", "summary"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"totalUrls\": 15,\n  \"totalClicks\": 142,\n  \"activeUrls\": 12,\n  \"expiredUrls\": 3,\n  \"averageClicksPerUrl\": 9.47,\n  \"mostClickedUrl\": \"https://example.com/popular-page\",\n  \"mostClickedUrlClicks\": 25\n}"
            }
          ]
        },
        {
          "name": "Get User URLs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/urls",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "urls"]
            },
            "description": "Get all URLs created by the authenticated user with statistics"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwt_token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/dashboard/urls",
                  "host": ["{{base_url}}"],
                  "path": ["dashboard", "urls"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "[\n  {\n    \"id\": 1,\n    \"code\": \"abc12345\",\n    \"originalUrl\": \"https://example.com/page1\",\n    \"usageCount\": 15,\n    \"createdAt\": \"2024-01-15T10:30:00\",\n    \"expiration\": \"2024-12-31T23:59:59\",\n    \"isExpired\": false\n  },\n  {\n    \"id\": 2,\n    \"code\": \"def67890\",\n    \"originalUrl\": \"https://example.com/page2\",\n    \"usageCount\": 3,\n    \"createdAt\": \"2024-01-16T14:20:00\",\n    \"expiration\": null,\n    \"isExpired\": false\n  }\n]"
            }
          ]
        },
        {
          "name": "Get Top Performing URLs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/urls/top?limit=5",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "urls", "top"],
              "query": [
                {
                  "key": "limit",
                  "value": "5",
                  "description": "Number of top URLs to return (default: 10)"
                }
              ]
            },
            "description": "Get the most clicked URLs for the authenticated user"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwt_token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/dashboard/urls/top?limit=5",
                  "host": ["{{base_url}}"],
                  "path": ["dashboard", "urls", "top"],
                  "query": [
                    {
                      "key": "limit",
                      "value": "5"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "[\n  {\n    \"id\": 1,\n    \"code\": \"abc12345\",\n    \"originalUrl\": \"https://example.com/most-popular\",\n    \"usageCount\": 25,\n    \"createdAt\": \"2024-01-15T10:30:00\",\n    \"expiration\": null,\n    \"isExpired\": false\n  },\n  {\n    \"id\": 3,\n    \"code\": \"ghi11111\",\n    \"originalUrl\": \"https://example.com/second-popular\",\n    \"usageCount\": 18,\n    \"createdAt\": \"2024-01-17T09:15:00\",\n    \"expiration\": \"2024-06-30T23:59:59\",\n    \"isExpired\": false\n  }\n]"
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script to ensure JWT token is available for protected endpoints",
          "if (pm.request.auth && pm.request.auth.type === 'bearer') {",
          "    const token = pm.collectionVariables.get('jwt_token');",
          "    if (!token) {",
          "        console.log('Warning: JWT token not set. Please login first.');",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script for common validations",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test('Response has valid Content-Type', function () {",
          "    if (pm.response.headers.get('Content-Type')) {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "    }",
          "});"
        ]
      }
    }
  ]
}
